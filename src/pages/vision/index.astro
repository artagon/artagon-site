---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/BaseLayout.astro';
import '../../styles/vision.css';

const entry = await getEntry('pages', 'vision');
if (!entry) {
  throw new Error('Vision page content not found');
}

const { Content } = await render(entry);
const { title, description } = entry.data;
---

<Base title={title} description={description} path="/vision">


  <article class="vision-doc">
    <Content />
  </article>


</Base>

