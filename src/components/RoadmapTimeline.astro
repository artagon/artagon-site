---
// USMR Phase 5.7 — /roadmap 5-card timeline. Token-only port of
// new-design/extracted/src/components/Roadmap.jsx. Static — no
// React island, no client interactivity.
import { ROADMAP_PHASES, ROADMAP_STATUS } from '../data/roadmap';
import { parseGlossaryText } from '../data/glossary';
import type { MarketingCopy } from '../lib/marketing-copy';
import HeadlineText from './HeadlineText.astro';
import GlossaryText from './GlossaryText.astro';
interface Props { copy: MarketingCopy; }
const { copy } = Astro.props;
---
<section class="roadmap-timeline" aria-labelledby="roadmap-timeline-heading" id="roadmap-timeline">
  <div class="roadmap-timeline__head">
    <div>
      <p class="roadmap-timeline__eyebrow eyebrow">{copy.eyebrow}</p>
      <h1 id="roadmap-timeline-heading" class="roadmap-timeline__title display">
        <HeadlineText text={copy.headline} emphasisClass="roadmap-timeline__title-emphasis" />
      </h1>
    </div>
    <p class="roadmap-timeline__lede lead">
      <GlossaryText nodes={parseGlossaryText(copy.lede)} />
    </p>
  </div>

  <ol class="roadmap-timeline__phases" aria-label="Roadmap phases V1 through V5">
    {ROADMAP_PHASES.map((phase) => {
      const meta = ROADMAP_STATUS[phase.status];
      return (
        <li id={phase.id} class={`roadmap-phase roadmap-phase--${phase.status}`}>
          <header class="roadmap-phase__head">
            <span class="roadmap-phase__version">{phase.version}</span>
            <span class="roadmap-phase__when">{phase.when}</span>
          </header>

          <p class="roadmap-phase__status">
            <span class="roadmap-phase__dot" aria-hidden="true" />
            <span>{meta.label}</span>
          </p>

          <h2 class="roadmap-phase__title">{phase.title}</h2>

          <ul class="roadmap-phase__items">
            {phase.items.map((item) => (
              <li class="roadmap-phase__item">
                <span class="roadmap-phase__bullet" aria-hidden="true">·</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .roadmap-timeline {
    padding-block: clamp(80px, 8vw, 120px);
  }

  .roadmap-timeline__head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 56px;
    max-width: var(--maxw, 1240px);
    margin-inline: auto;
    padding-inline: clamp(24px, 4vw, 40px);
  }

  /* Canonical .eyebrow contract per USMR 5.5.16-pt16. */
  /* USMR 14.10: .eyebrow owns the shared type and dash; keep local spacing. */
  .roadmap-timeline__eyebrow {
    margin: 0 0 24px;
  }

  .roadmap-timeline__title {
    font-family: var(--f-display);
    /* USMR Phase 5.5.9 — canonical h2 scale per global.css:230. */
    font-size: clamp(36px, 4vw, 60px);
    line-height: 1.02;
    letter-spacing: var(--display-tracking, -0.025em);
    font-weight: var(--display-weight, 500);
    color: var(--fg);
    margin: 0;
  }
  .roadmap-timeline__title :global(.roadmap-timeline__title-emphasis) {
    font-family: var(--f-emphasis, var(--f-serif));
    font-style: italic;
  }

  /* Canonical Roadmap.jsx — .lead 20 / fg-1 / 1.5 (Pillars/Bridge/
   * Standards/UseCases ledes all use the same canonical contract). */
  .roadmap-timeline__lede {
    font-size: 20px;
    line-height: 1.5;
    color: var(--fg-1);
    max-width: 48ch;
    justify-self: end;
    margin: 0;
  }

  @media (max-width: 1024px) {
    .roadmap-timeline__head {
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
      margin-bottom: 40px;
    }
    .roadmap-timeline__lede {
      justify-self: start;
    }
  }

  .roadmap-timeline__phases {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--bg-1);
    max-width: var(--maxw, 1240px);
    margin-inline: auto;
  }

  @media (max-width: 1024px) {
    .roadmap-timeline__phases {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .roadmap-timeline__phases {
      grid-template-columns: 1fr;
    }
  }

  .roadmap-phase {
    padding: 24px;
    border-right: 1px solid var(--line-soft);
    position: relative;
    min-height: 360px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .roadmap-phase:last-child {
    border-right: 0;
  }
  @media (max-width: 1024px) {
    .roadmap-phase {
      border-right: 1px solid var(--line-soft);
      border-bottom: 1px solid var(--line-soft);
    }
    .roadmap-phase:nth-child(2n) {
      border-right: 0;
    }
  }
  @media (max-width: 540px) {
    .roadmap-phase {
      border-right: 0;
    }
  }

  .roadmap-phase__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .roadmap-phase__version {
    font-family: var(--f-mono);
    /* Canonical Roadmap.jsx:54 — `fontSize: 28` (was 1.75rem = 28
     * at root 16; canonical fixes px). */
    font-size: 28px;
    font-weight: 500;
    color: var(--fg);
    letter-spacing: -0.02em;
  }

  /* Canonical Roadmap.jsx:57 — when label `fontSize: 11`. */
  .roadmap-phase__when {
    font-family: var(--f-mono);
    font-size: 11px;
    color: var(--fg-3);
  }

  /* Canonical Roadmap.jsx:62 — status pill `fontSize: 10.5`. */
  .roadmap-phase__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--f-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .roadmap-phase__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
  }

  /* USMR 14.13 review R3: scoped modifiers own status colors. */
  .roadmap-phase--shipping { --phase-color: var(--ok); }
  .roadmap-phase--in-build { --phase-color: var(--accent); }
  .roadmap-phase--design { --phase-color: var(--warn); }
  .roadmap-phase--planned { --phase-color: var(--fg-3); }
  .roadmap-phase__dot,
  .roadmap-phase__status { color: var(--phase-color); }
  .roadmap-phase__dot {
    background: var(--phase-color);
    box-shadow: 0 0 10px var(--phase-color);
  }
  .roadmap-phase--planned .roadmap-phase__dot {
    box-shadow: none;
  }

  /* Canonical Roadmap.jsx:65 — phase title `fontSize: 18`. */
  .roadmap-phase__title {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--fg);
    margin: 0;
  }

  .roadmap-phase__items {
    list-style: none;
    padding: 18px 0 0;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--line-soft);
  }

  /* Canonical Roadmap.jsx:71 — list item `fontSize: 12.5`. */
  .roadmap-phase__item {
    font-size: 12.5px;
    color: var(--fg-1);
    line-height: 1.45;
    display: flex;
    gap: 8px;
  }

  .roadmap-phase__bullet {
    color: var(--fg-3);
    margin-top: 1px;
  }

  @media (forced-colors: active) {
    .roadmap-phase__dot {
      background: CanvasText;
      box-shadow: none;
    }
    .roadmap-phase--shipping .roadmap-phase__dot,
    .roadmap-phase--in-build .roadmap-phase__dot {
      background: Highlight;
    }
    .roadmap-phase--design .roadmap-phase__dot {
      background: Mark;
    }
    .roadmap-phase--shipping .roadmap-phase__status,
    .roadmap-phase--in-build .roadmap-phase__status {
      color: Highlight;
    }
    .roadmap-phase--design .roadmap-phase__status {
      color: Mark;
    }
  }
</style>
